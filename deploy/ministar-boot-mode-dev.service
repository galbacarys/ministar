[Unit]
Description=ministar boot mode (AP default, one-shot WLAN, astroberry dev)
Documentation=https://github.com/galbacarys/ministar
After=NetworkManager.service
Wants=NetworkManager.service
Before=ministar.service

[Service]
Type=oneshot
Environment=MINISTAR_HOME=/home/astroberry/.ministar
Environment=MINISTAR_AP_PROFILE=ministar-test-ap
ExecStart=/usr/local/sbin/ministar-boot-mode

[Install]
WantedBy=multi-user.target
