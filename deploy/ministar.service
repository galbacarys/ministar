[Unit]
Description=ministar console
Documentation=https://github.com/galbacarys/ministar
After=NetworkManager.service avahi-daemon.service
Wants=NetworkManager.service

[Service]
Type=simple
User=ministar
Group=ministar
SupplementaryGroups=plugdev
WorkingDirectory=/opt/ministar/app
Environment=HOME=/var/lib/ministar
Environment=MINISTAR_HOME=/var/lib/ministar
Environment=MINISTAR_CAMERA=gphoto2
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ministar/venv/bin/python -m ministar.ui.app \
  --host 0.0.0.0 --port 443 \
  --ssl-certfile /etc/ministar/tls/leaf.crt \
  --ssl-keyfile /etc/ministar/tls/leaf.key \
  --http-port 80 --ca-cert /etc/ministar/tls/ca.crt \
  --no-show
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillSignal=SIGTERM
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/var/lib/ministar /media

[Install]
WantedBy=multi-user.target
